<UserControl
    x:Class="CodexBar.Shell.Charts.UsageHistoryChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="4">
        <TextBlock x:Name="ChartTitle"
                   Style="{StaticResource BodyStrongTextBlockStyle}" />
        <!-- Chart placeholder: LiveCharts/SkiaSharp removed to avoid native heap corruption on startup -->
        <Border x:Name="ChartPlaceholder"
                Width="600"
                Height="300"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="4" />
    </StackPanel>
</UserControl>
