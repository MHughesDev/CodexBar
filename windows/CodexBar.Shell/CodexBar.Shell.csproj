<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>CodexBar.Shell</RootNamespace>
    <AssemblyName>CodexBar.Shell</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <UseWinUI>true</UseWinUI>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Pri/Mrt resource-indexing MSBuild tasks ship with Visual Studio's UWP workload, which isn't
         installed here. The app has no .resw resources, so skip that tooling entirely. -->
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <EnablePriGenTooling>false</EnablePriGenTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240627000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.756" PrivateAssets="all" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.1.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.7" />
    <!-- LiveChartsCore.SkiaSharpView.WinUI removed: libSkiaSharp.dll native init corrupts heap on startup -->
    <!-- TODO: Investigate SkiaSharp version compatibility before re-enabling -->
  </ItemGroup>

  <!-- WinUI's Application.Start crashes with a stowed exception if the app has no resources.pri, even
       with no .resw files. The real Pri-generation MSBuild task requires Visual Studio's UWP workload
       (not installed here), so generate resources.pri directly with makepri.exe from the SDK BuildTools
       NuGet package instead. -->
  <Target Name="GenerateResourcesPri" AfterTargets="Build" Condition="Exists('$(MakePriExeFullPath)')">
    <PropertyGroup>
      <_PriConfigPath>$(IntermediateOutputPath)priconfig.xml</_PriConfigPath>
    </PropertyGroup>
    <Exec Command="&quot;$(MakePriExeFullPath)&quot; createconfig /cf &quot;$(_PriConfigPath)&quot; /dq en-US /pv 10.0.0 /o" />
    <Exec Command="&quot;$(MakePriExeFullPath)&quot; new /pr &quot;$(MSBuildProjectDirectory)&quot; /cf &quot;$(_PriConfigPath)&quot; /of &quot;$(OutDir)resources.pri&quot; /IndexName $(TargetName) /o" />
  </Target>

</Project>
